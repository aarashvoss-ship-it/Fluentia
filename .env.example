# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never expose this as NEXT_PUBLIC_* or in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only Paasta S3-compatible object storage credentials and endpoint.
# The bucket must allow public reads for returned object URLs to load in browsers.
AWS_ACCESS_KEY_ID=your-paasta-s3-access-key
AWS_SECRET_ACCESS_KEY=your-paasta-s3-secret-key
AWS_ENDPOINT_URL=https://your-paasta-s3-endpoint
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=fluentia-assets
# Server-only secret for signing native authentication session cookies (at least 32 random bytes).
JWT_SECRET=replace-with-at-least-32-random-bytes
# Server-only direct connection to the independent PaasTA PostgreSQL database.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Server-only Paasta OpenAI-compatible API credentials for Academis.
PAASTA_AI_API_KEY=your-paasta-ai-api-key
PAASTA_AI_MODEL=google/gemini-2.5-flash-lite
# Optional model registry overrides (task-specific model > AI_MODEL > PAASTA_AI_MODEL).
# AI_MODEL=openai/gpt-5
# ACADEMIS_EVAL_MODEL=openai/gpt-5
# LESSON_BUILDER_MODEL=google/gemini-2.5-flash-lite
# Optional output-token cap and token field override. By default GPT-5/reasoning models use
# max_completion_tokens; other OpenAI-compatible models use max_tokens.
# AI_MAX_OUTPUT_TOKENS=8192
# ACADEMIS_EVAL_MAX_OUTPUT_TOKENS=8192
# AI_TOKEN_LIMIT_PARAMETER=max_completion_tokens
# ACADEMIS_EVAL_TOKEN_LIMIT_PARAMETER=max_completion_tokens
# Optional OpenAI-compatible endpoint override.
# PAASTA_AI_BASE_URL=https://console.paasta.cloud/api/ai/v1/chat/completions
